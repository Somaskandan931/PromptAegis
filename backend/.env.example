# Default downstream LLM: a local Ollama server (no API key needed).
#   ollama pull llama3.1:8b
#   ollama serve
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=120

# Optional hosted alternative (set LLM_PROVIDER=groq). Leave the key empty if unused.
# Never commit a real key; backend/.env is gitignored.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
